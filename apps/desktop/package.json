{
  "name": "@devkit/desktop",
  "productName": "DevKit",
  "version": "0.9.0",
  "private": true,
  "description": "Local development environment for Laravel and Angular in WSL.",
  "author": "y0unes",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "start": "electron .",
    "icons": "node scripts/make-icons.mjs",
    "dist": "node build.mjs && electron-builder --win nsis --publish never",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@devkit/shared": "*",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.2"
  },
  "build": {
    "appId": "dev.devkit.app",
    "productName": "DevKit",
    "copyright": "y0unes",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "../daemon/dist/devkitd", "to": "devkitd" },
      { "from": "../ui/dist/ui/browser", "to": "ui" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "executableName": "DevKit"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DevKit",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
